; Engine configuration file.
; Godot 4.7.1 — Jimothy the raccoon virtual pet

config_version=5

[application]

config/name="Jimothy"
config/description="Tamagotchi-style virtual pet starring Jimothy the raccoon. Tracks real time. Exportable to Android and web."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

PetState="*res://scripts/pet_state.gd"

[display]

window/size/viewport_width=420
window/size/viewport_height=860
window/size/window_width_override=420
window/size/window_height_override=860
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

