+static func _style_main_surfaces(root: Control) -> void:
+	var device := root.get_node_or_null("Margin/VBox/Device") as PanelContainer
+	var screen := root.get_node_or_null("Margin/VBox/Device/DeviceMargin/DeviceVBox/Screen") as PanelContainer
+
+	if device:
+		device.add_theme_stylebox_override(
+			"panel",
+			_panel_style(Color(0.035, 0.12, 0.085, 0.34), Color(0.88, 0.96, 0.86, 0.16), 24, 10)
+		)
+	if screen:
+		screen.add_theme_stylebox_override(
+			"panel",
+			_panel_style(Color(0.96, 0.98, 0.92, 0.12), Color(1.0, 1.0, 1.0, 0.14), 20, 0)
+		)
+
+	for node in _descendants(root):
+		if node is PanelContainer:
+			var panel := node as PanelContainer
+			if panel == device or panel == screen:
+				continue
+			if panel.name.to_lower().contains("card"):
+				panel.add_theme_stylebox_override(
+					"panel",
+					_panel_style(Color(0.055, 0.13, 0.095, 0.98), Color(0.96, 0.88, 0.7, 0.25), 22, 12)
+				)
+
+
