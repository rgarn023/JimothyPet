+extends RefCounted
+## Runtime visual theme for the Jimothy Raccoon Pet f814 branch.
+## Keeps gameplay and scene structure intact while giving the UI a softer,
+## rounded, premium virtual-pet presentation.
+
+const INK := Color("17231c")
+const CREAM := Color("fff4df")
+const GOLD := Color("efbe69")
+const DEEP_GREEN := Color("173e2d")
+const MID_GREEN := Color("2d6848")
+const SOFT_GREEN := Color("82b890")
+
+
+static func apply(root: Control) -> void:
+	if root == null or root.has_meta("jimothy_visual_polish_applied"):
+		return
+	root.set_meta("jimothy_visual_polish_applied", true)
+
+	_style_main_surfaces(root)
+	_style_meters(root)
+	_style_text(root)
+	_style_all_controls(root)
+	_enhance_feed_panel(root)
+	_style_minigame_surfaces(root)
+	_play_entrance(root)
+
+
+static func play_stage_flash(root: Control) -> void:
+	if root == null:
+		return
+	var flash := ColorRect.new()
+	flash.name = "StageFlash"
+	flash.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	flash.color = Color(1.0, 0.86, 0.5, 1.0)
+	flash.modulate.a = 0.0
+	flash.z_index = 500
+	root.add_child(flash)
+	flash.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+
+	var tween := root.create_tween()
+	tween.set_trans(Tween.TRANS_QUAD)
+	tween.set_ease(Tween.EASE_OUT)
+	tween.tween_property(flash, "modulate:a", 0.18, 0.16)
+	tween.tween_property(flash, "modulate:a", 0.0, 0.5)
+	tween.tween_callback(flash.queue_free)
+
+
+static func animate_modal(panel: Control) -> void:
+	if panel == null:
+		return
+	panel.modulate.a = 0.0
+	var tween := panel.create_tween()
+	tween.set_trans(Tween.TRANS_QUAD)
+	tween.set_ease(Tween.EASE_OUT)
+	tween.tween_property(panel, "modulate:a", 1.0, 0.18)
+
+
+static func play_food_flash(root: Control, food_key: String) -> void:
+	if root == null:
+		return
+	var colors := {
+		"berries": Color("7a6ab0"),
+		"crickets": Color("7b8650"),
+		"fish": Color("78aebb"),
+		"pizza": Color("e0a04a"),
+		"fries": Color("c45c4a"),
+	}
+	var col: Color = colors.get(food_key, GOLD)
+	var flash := ColorRect.new()
+	flash.name = "FoodFlash"
+	flash.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	flash.color = Color(col.r, col.g, col.b, 0.0)
+	flash.z_index = 450
+	root.add_child(flash)
+	flash.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	var tween := root.create_tween()
+	tween.tween_property(flash, "color:a", 0.12, 0.1)
+	tween.tween_property(flash, "color:a", 0.0, 0.38)
+	tween.tween_callback(flash.queue_free)
+
